# =============================================================
# AI4SIDS Configuration
# =============================================================
# Copy this file to .env and fill in the values.
#
# LLM Backend priority (first one set wins):
#   1. OPENAI_API_BASE_URL  → External OpenAI-compatible endpoint
#   2. NVIDIA_API_KEY        → NVIDIA NIM (cloud)
#   3. Neither               → Local Ollama (default)
# =============================================================

# --- Option 1: External OpenAI-compatible endpoint ---
# Use this to connect to a colleague's OpenWebUI, vLLM, LocalAI, etc.
# Set both the base URL and API key. LLM_MODEL should match a model
# available on that server (check their /v1/models endpoint).
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# --- Option 2: NVIDIA NIM (cloud) ---
NVIDIA_API_KEY=

# --- Option 3: Local Ollama (default fallback) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Shared LLM settings ---
# Leave LLM_MODEL empty to use the default for your chosen backend.
# Or override it with a specific model name.
LLM_MODEL=
LLM_TEMPERATURE=0.1

# Data Backend API URL (the separate service that serves live/simulated data)
DATA_BACKEND_URL=http://localhost:8080

# LangSmith Monitoring (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai4sids

# Logging
LOG_LEVEL=INFO
