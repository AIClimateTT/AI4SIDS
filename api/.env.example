# API Configuration

# Background Task Control
# Local development: true (enable background data generation)
# Railway/Render free tier: false (disable to allow app sleeping)
# Can also be controlled via API endpoints:
#   GET  /api/data-generation/status
#   POST /api/data-generation/start
#   POST /api/data-generation/stop
ENABLE_BACKGROUND_TASK=false

# Data Generation Cycle Interval (in seconds) - only used if background task enabled
# Development (fast demo): 15
# Production Railway/Render: 3600 (1 hour)
# Production with lots of traffic: 900 (15 minutes)
DATA_CYCLE_INTERVAL=3600

# CORS Origins (comma-separated)
# Local: http://localhost:3000
# Production: https://your-app.netlify.app
CORS_ORIGINS=http://localhost:3000,https://your-app.netlify.app

# Database
DATABASE_URL=sqlite:///./ai4sids_demo.db
