# Base URLs
VITE_BASE_URL=http://localhost:3000

# API Configuration
# For local development
VITE_API_URL=http://localhost:8000

# For production (set this in Netlify environment variables)
# VITE_API_URL=https://your-backend-url.railway.app

# API Polling Intervals (in seconds)
# How often to refetch real-time data, system updates, etc.
VITE_REFETCH_INTERVAL=15

# How often to refetch locations list (changes less frequently)
VITE_LOCATIONS_REFETCH_INTERVAL=60

# How often to refetch analytics data
VITE_ANALYTICS_REFETCH_INTERVAL=60

# How often to check prediction task status
VITE_PREDICTION_STATUS_REFETCH_INTERVAL=30

# How often to check API status
VITE_API_STATUS_REFETCH_INTERVAL=30

# Data Freshness (in seconds)
# How long before cached data is considered stale
VITE_STALE_TIME=15

# Threshold for considering data "fresh" (for UI indicators)
VITE_DATA_FRESH_THRESHOLD=30

# Retry Configuration
# Number of times to retry failed API requests
VITE_RETRY_COUNT=3

# Base delay in seconds for retry (uses exponential backoff)
VITE_RETRY_DELAY_BASE=5

# Demo Mode Configuration
# For video recording or demos, you may want faster intervals:
# VITE_REFETCH_INTERVAL=1
# VITE_LOCATIONS_REFETCH_INTERVAL=1
# VITE_ANALYTICS_REFETCH_INTERVAL=1
# VITE_PREDICTION_STATUS_REFETCH_INTERVAL=1
# VITE_STALE_TIME=2
