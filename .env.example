# =============================================================
# AI4SIDS — root environment (docker-compose / Dokploy)
# Copy to .env and set real values before deploying.
# Every variable here is read by docker-compose.yml.
# Note: the rag service also needs rag/.env to exist
# (copy rag/.env.example — the compose file mounts it via env_file).
# =============================================================

# --- Frontend ---
# Public hostname or IP the browser uses to reach this server.
# Baked into the frontend bundle at build time (no protocol, no trailing slash).
DOMAIN=staging.example.com

# --- Ollama / LLM ---
# Model pulled automatically on first deploy and used by the RAG.
# e.g. llama3.2 (small/CPU), llama3.1:8b, gpt-oss:20b (needs 24GB GPU)
LLM_MODEL=gpt-oss:20b

# --- Postgres (db service + api connection) ---
POSTGRES_USER=ai4sids
POSTGRES_PASSWORD=set-a-strong-db-password
POSTGRES_DB=ai4sids_gov

# --- API auth ---
# JWT signing key — generate one: openssl rand -hex 32
SECRET_KEY=set-a-long-random-secret
# First super-admin account (created on startup if missing).
SUPERADMIN_EMAIL=admin@ai4sids.org
SUPERADMIN_PASSWORD=set-a-strong-admin-password
# true = seed two demo orgs with org-admin/member accounts (demo only)
SEED_DEMO_ORGS=false
